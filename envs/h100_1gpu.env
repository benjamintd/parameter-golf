# Single H100 run — full model, larger batches
# ~69M params, ~30 min runtime on 1xH100
DIM=512
NUM_HEADS=8
DEPTH=12
NUM_EXPERTS=64
HIDDEN_MULT=2
SEQ_LEN=1024
BATCH_SIZE=16
NUM_STEPS=5000
VAL_EVERY=200
VAL_TOKENS_QUICK=500000
VAL_TOKENS_FULL=5000000
LR=1e-3
WEIGHT_DECAY=0.01
REPORT_DIR=benchmark_report/h100_1gpu
