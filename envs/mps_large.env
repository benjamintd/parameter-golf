# Scaled-up model for MPS — uses gradient checkpointing
# ~25M params, ~15 min runtime
MODEL_DIM=512
NUM_HEADS=8
DEPTH=12
NUM_EXPERTS=24
MLP_MULT=2
TRAIN_SEQ_LEN=128
BATCH_SIZE=2
NUM_STEPS=500
VAL_EVERY=50
VAL_TOKENS_QUICK=50000
VAL_TOKENS_FULL=500000
LR=1e-3
WEIGHT_DECAY=0.01
REPORT_DIR=benchmark_report/mps_large
