# Small model for quick iteration on MPS (Apple Silicon)
# ~4.7M params, ~2 min runtime
MODEL_DIM=256
NUM_HEADS=8
DEPTH=4
NUM_EXPERTS=16
MLP_MULT=2
TRAIN_SEQ_LEN=256
BATCH_SIZE=2
NUM_STEPS=500
VAL_EVERY=50
VAL_TOKENS_QUICK=50000
VAL_TOKENS_FULL=500000
LR=1e-3
WEIGHT_DECAY=0.01
REPORT_DIR=benchmark_report/mps_small
